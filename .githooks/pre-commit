#!/usr/bin/env bash
# Pre-commit gate for Prevasum/.github. Runs the same checks as the
# `actionlint` and `deliver-reproducible` jobs in `.github/workflows/ci.yml`.
#
# Enable once per clone:
#
#     git config core.hooksPath .githooks

set -euo pipefail

if ! git diff --cached --quiet -- .github/workflows; then
  echo "==> actionlint"
  if ! command -v actionlint >/dev/null; then
    echo "Error: actionlint is not installed. Install release 1.7.12 or newer:"
    echo "  macOS:  brew install actionlint"
    echo "  Linux:  https://github.com/rhysd/actionlint/blob/main/docs/install.md"
    echo "Commit aborted."
    exit 1
  fi
  actionlint || {
    echo "Error: actionlint failed. Commit aborted."
    exit 1
  }
fi

if ! git diff --cached --quiet -- .github/workflows/deliver.yml .github/scripts/deliver-reproducible.sh; then
  echo "==> deliver-reproducible"
  for tool in docker jq yq; do
    if ! command -v "$tool" >/dev/null; then
      echo "Error: $tool is not installed. The check needs docker with buildx, jq, and"
      echo "mikefarah's yq v4 (https://github.com/mikefarah/yq#install). Commit aborted."
      exit 1
    fi
  done
  .github/scripts/deliver-reproducible.sh || {
    echo "Error: deliver-reproducible failed. Commit aborted."
    exit 1
  }
fi
